# Every day at 03:00 Moscow time. Persistent: if the server was off at 03:00,
# the backup runs right after it starts.
[Unit]
Description=PocketCRM: daily backup of the prod database at 03:00 Moscow time

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target
