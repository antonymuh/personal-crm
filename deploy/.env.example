# Server-side .env for the production stack. Lives in /opt/crm/prod/.env (chmod 600).
# Never commit real values.

# Password for the production PostgreSQL container. Pick a long random one.
POSTGRES_PASSWORD=

# Connection string used by the app and migrations inside Docker ("db" is the database service).
# Format: postgresql://crm:<POSTGRES_PASSWORD>@db:5432/personal_crm
DATABASE_URL=

# Secret that signs sign-in cookies. A long random string, e.g. the output of:
#   openssl rand -base64 32
# Changing it signs everybody out.
BETTER_AUTH_SECRET=

# The public address of the app; links in sign-in emails point here.
# Format: https://app.pocketcrm.co
BETTER_AUTH_URL=

# Where sign-in emails go: Resend over SMTP. The password is a Resend API key
# with sending access to the mail.crm.pocketcrm.co domain only.
# Format: smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
SMTP_URL=

# The owner's email. Contacts, notes and groups from before sign-in was added
# become this user's on the first deploy with sign-in; the migration stops if
# it is missing while such data exists.
OWNER_EMAIL=
