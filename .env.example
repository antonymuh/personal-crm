# Copy this file to .env and fill in the values. Do not commit .env.

# Password for the local PostgreSQL container (read by docker-compose.yml).
# Pick any password; it only has to match the one inside DATABASE_URL.
POSTGRES_PASSWORD=

# Connection string for the local PostgreSQL running in Docker.
# Format: postgresql://crm:<POSTGRES_PASSWORD>@localhost:5432/personal_crm
DATABASE_URL=
