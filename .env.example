# Copy this file to .env and fill in the values. Do not commit .env.

# Password for the local PostgreSQL container (read by docker-compose.yml).
# Pick any password; it only has to match the one inside DATABASE_URL.
POSTGRES_PASSWORD=

# Connection string for the local PostgreSQL running in Docker.
# Format: postgresql://crm:<POSTGRES_PASSWORD>@localhost:5432/personal_crm
DATABASE_URL=

# Secret that signs sign-in cookies. Any long random string, e.g. the output of:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Address the app is opened at; links in sign-in emails point here.
# Locally: http://localhost:3000
BETTER_AUTH_URL=

# Where emails go. Locally: the Mailpit inbox from docker-compose.yml.
# Locally: smtp://localhost:1025
SMTP_URL=

# Your own email. Contacts, notes and groups that existed before sign-in was
# added, and the demo data from `pnpm db:seed`, belong to the user with this email.
OWNER_EMAIL=
